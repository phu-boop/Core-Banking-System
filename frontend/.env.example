# Generate a local secret with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_KEYCLOAK_ID=core-banking-web
AUTH_KEYCLOAK_ISSUER=http://localhost:8180/realms/core-banking

# Server-to-server URL; the browser never calls Identity Service directly.
IDENTITY_API_BASE_URL=http://localhost:8080
